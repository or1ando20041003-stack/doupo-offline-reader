{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["scripts/**/*.ts", "src/book-processing/**/*.ts", "src/deployment/**/*.ts", "src/domain/**/*.ts"]
}
